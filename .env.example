# Every variable the code reads. Copy to .env.local for local dev (gitignored). Never commit real values.

# Public origin, no trailing slash. All absolute URLs (Lemon receipt links, OG images, emails) come from this.
# LOCAL DEV: set this to http://localhost:3000 so checkout notices never bounce to sachapandit.com.
#   NEXT_PUBLIC_URL=http://localhost:3000
# PRODUCTION: https://sachapandit.com
# If this is empty or points at another host, post-checkout redirects use the current request origin instead.
NEXT_PUBLIC_URL=https://sachapandit.com
# Optional. Brand shown everywhere. Defaults to "Sacha Pandit".
NEXT_PUBLIC_BRAND_NAME="Sacha Pandit"

# Lemon Squeezy (merchant of record). Existing pay-what-you-want variant stays for the petition certificate.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
# $10 Visa Wish Certificate variant. Price comes from this variant; the client never sends an amount.
LEMON_SQUEEZY_VISA_VARIANT_ID=
# $10/month Sacha Pandit Premium subscription variant. Recurring; never send customPrice.
# Also used as the Believer seat when LEMON_SQUEEZY_BELIEVER_VARIANT_ID is empty.
LEMON_SQUEEZY_PREMIUM_VARIANT_ID=
# Monthly seats. Set each variant's price in Lemon ($9, $29, $99). Put a 7-day trial on the Believer variant.
# Empty Devotee or Darshan keeps that button closed. Empty Darshan shows the waitlist instead.
LEMON_SQUEEZY_BELIEVER_VARIANT_ID=
LEMON_SQUEEZY_DEVOTEE_VARIANT_ID=
LEMON_SQUEEZY_DARSHAN_VARIANT_ID=
# Religion of Mars — five one-time offerings. Create each product+variant in Lemon at the listed USD price.
# Reviewer blurb: content/offerings.ts (lemonReviewerBlurb).
#   1) Send a Prayer to Mars — $10 one-time → LEMON_SQUEEZY_VARIANT_ID_PRAYER_10
#   2) Wall of Mars Name — $20 one-time → LEMON_SQUEEZY_VARIANT_ID_WALL_20
#   3) Personal Wish Ritual — $25 one-time → LEMON_SQUEEZY_VARIANT_ID_WISH_25
#   4) Patron of Mars — $50 one-time → LEMON_SQUEEZY_VARIANT_ID_PATRON_50
#   5) Founder Name Engraving — $1,000 one-time → LEMON_SQUEEZY_VARIANT_ID_FOUNDER_ENGRAVING_1000
# Shared: LEMON_SQUEEZY_API_KEY, LEMON_SQUEEZY_STORE_ID, LEMON_SQUEEZY_WEBHOOK_SECRET
# Webhook URL: https://YOUR_DOMAIN/api/webhook
#   Events: order_created (required), order_refunded (optional)
# Custom data on checkout: kind=mars, tier, blessing_id, user_id, sol, name
#   Prayer/wish text is stored server-side only — never sent in Lemon custom data.
# Checkout: POST /api/mars/checkout → Lemon URL; confirmation: /blessing/[id] after paid webhook.
# Public lists: /wall (Wall of Mars), /patrons, /monument (Founder engraving). /offerings is the desk.
# Apply migration 016_religion_mars_offerings.sql for message + wall_of_mars + founder_monument.
LEMON_SQUEEZY_VARIANT_ID_PRAYER_10=
LEMON_SQUEEZY_VARIANT_ID_WALL_20=
LEMON_SQUEEZY_VARIANT_ID_WISH_25=
LEMON_SQUEEZY_VARIANT_ID_PATRON_50=
LEMON_SQUEEZY_VARIANT_ID_FOUNDER_ENGRAVING_1000=
# Legacy Mars variant keys (optional fallbacks only — prefer the IDs above).
LEMON_SQUEEZY_SETTLERS_MARK_VARIANT_ID=
LEMON_SQUEEZY_BLESSING_VARIANT_ID=
LEMON_SQUEEZY_DEEPER_VARIANT_ID=
LEMON_SQUEEZY_PATRON_VARIANT_ID=
LEMON_SQUEEZY_COVENANT_VARIANT_ID=
# Red Path Lemon products (create in dashboard). Reviewer copy: digital novelty artifact.
# Never mention AI. Never say donation (except "Not a donation"). All payments via Lemon — no Stripe for Red Path.
#   1) The First Offering — $5 one-time
#   2) The Settler's Mark — $10 one-time
#   3) The Dust Covenant — $20 one-time
#   4) The Daily Practice — $5/month subscription
#   5) The Induction — $1,000 one-time, inventory 108
# Webhook URL: /api/webhook/lemon
#   Events: order_created, subscription_created|updated|cancelled|expired|payment_failed
# Checkout: POST /api/checkout/offering { tier } → { url }
#   one-time success: /archive?upgraded={tier}
#   practice success: /archive?practice=1
#   induction success: /induction/confirmed (Founder seat seals on webhook)
#   induction pending/failed UX: /induction/pending | /induction/failed
# Portal: GET /api/checkout/portal → Lemon customer portal URL
# Founder fulfillment: webhook assigns position 1–108, queues physical pack,
# emails inductee (ceremony URL) + operator (FULFILLMENT_EMAIL).
# Induction checkout stays closed until API_KEY + STORE_ID + VARIANT_ID_INDUCTION are set.
# No installments — one-time $1000 only. Webhook URL must be /api/webhook/lemon (not /api/webhook).
# Dashboard: create "The Induction" $1000 one-time (inventory 108), paste variant id below.
# Webhook events: order_created (+ subscription_* for Daily Practice only).
# Redirect success: /induction/confirmed — membership seals only after paid webhook.
LEMON_SQUEEZY_VARIANT_ID_OFFERING_5=
LEMON_SQUEEZY_VARIANT_ID_SETTLER_10=
LEMON_SQUEEZY_VARIANT_ID_COVENANT_20=
LEMON_SQUEEZY_VARIANT_ID_PRACTICE_MONTHLY=
LEMON_SQUEEZY_VARIANT_ID_INDUCTION=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Required on Vercel so /api/checkout/offering can mint mars_owner session.
SESSION_SECRET=
# Operator inbox for NEW FOUNDER packing tasks (falls back to RESEND_FROM_EMAIL).
FULFILLMENT_EMAIL=
OPERATOR_EMAIL=
# Optional. Empty keeps private ceremony as script-only page at /ceremony/[token].
HEYGEN_API_KEY=
RUNWAY_API_KEY=

# Signed-cookie session for Premium magic links and the anonymous mars_owner
# httpOnly cookie that authorizes private transmissions. Required in production.
SESSION_SECRET=

# Supabase. Server only. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider for petition readings. If both are empty, a local fallback pool is used.
# The altar (/api/pooja) requires OPENAI_API_KEY and always calls gpt-4o-mini.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Resend. If RESEND_API_KEY is empty, the petition certificate is still stored and the email is skipped.
RESEND_API_KEY=
# The sending domain sachapandit.com must be verified in Resend.
RESEND_FROM_EMAIL=church@sachapandit.com

# Upstash Redis for rate limits. If either is empty, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe Billing. Settler's Covenant is $10/month recurring (USD).
# Create Product "Settler's Covenant" + monthly price in the Stripe dashboard, then paste:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Legacy aliases (optional). STRIPE_PRICE_ID wins for the Mars covenant.
STRIPE_PRICE_BELIEVER=
STRIPE_PRICE_DEVOTEE=
STRIPE_PRICE_DARSHAN=
STRIPE_DARSHAN_OPEN=
# If STRIPE_PRICE_ID and STRIPE_PRICE_BELIEVER are empty, checkout sends 1000 cents itself.
# Webhook: /api/stripe/webhook (checkout.session.completed → settlers.tier=settler;
# customer.subscription.deleted → pilgrim).
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/pooja, /api/cron/sermon,
# /api/cron/episode, and /api/cron/letter (1st of month 09:00 UTC).
CRON_SECRET=
# Devotee congregation room. https only. Empty keeps the room closed.
DISCORD_INVITE_URL=
# Local only. Ignored when NODE_ENV=production. One of pilgrim, believer, devotee, darshan.
DEV_TIER=

# Sentry. Empty = disabled (no-op). Also exposed to the browser SDK as NEXT_PUBLIC_SENTRY_DSN at build time.
# Events keep only petition_id, soul_id, reference_id, order_id, tier, event_name, amount_cents.
SENTRY_DSN=
